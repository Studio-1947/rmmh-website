---
import Icon from "./Icon.astro";
import { initials, weekDays, type Doctor } from "../data/doctors";
import { site } from "../data/site";
import { getLang, l, useT } from "../i18n";

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const name = l(doctor.name, lang);
const byDay = new Map(doctor.availability.map((a) => [a.day, a.time]));
---

<article class="profile" id={doctor.slug} data-reveal>
  <aside class="profile-side">
    <div class="profile-photo">
      <img
        src={doctor.photo}
        alt={`${t("doctor.portrait")} ${name}`}
        style={doctor.photoZoom ? `--photo-zoom: ${doctor.photoZoom}` : undefined}
        loading="lazy"
        decoding="async"
        width="600"
        height="600"
      />
      <span class="profile-avatar" aria-hidden="true">{initials(doctor.name.en)}</span>
    </div>
    <h2>{name}</h2>
    <p class="doctor-spec">{l(doctor.specialty, lang)}</p>
    <ul class="profile-facts">
      <li><Icon name="i-pin" />{l(doctor.location, lang)}</li>
      {
        doctor.languages && (
          <li>
            <Icon name="i-users" />
            {doctor.languages.join(" · ")}
          </li>
        )
      }
    </ul>
    <a class="btn btn-primary" href={site.phoneHref}><Icon name="i-phone" />{t("doctor.book")}</a>
  </aside>

  <div class="profile-body">
    <p class="profile-bio">{l(doctor.bio, lang)}</p>

    {
      doctor.skills.length > 0 && (
        <>
          <h3 class="profile-label">{t("doctor.skills")}</h3>
          <ul class="skill-list">
            {doctor.skills.map((skill) => (
              <li>{l(skill, lang)}</li>
            ))}
          </ul>
        </>
      )
    }

    <h3 class="profile-label">
      {t("doctor.availability")}
      {!doctor.timingsConfirmed && <em class="tbc">{t("doctor.tbcLong")}</em>}
    </h3>
    <ol class="week" aria-label={t("doctor.week")}>
      {
        weekDays.map((day) => {
          const time = byDay.get(day);
          return (
            <li class:list={["week-day", { on: !!time }]}>
              <span class="week-name">{t(`day.${day}`)}</span>
              <span class="week-time">{time ?? t("doctor.off")}</span>
            </li>
          );
        })
      }
    </ol>

    <ol class="timeline" aria-label={t("doctor.slots")}>
      {
        doctor.availability.map((slot) => (
          <li>
            <span class="timeline-dot" aria-hidden="true" />
            <div>
              <strong>{t(`day.${slot.day}`)}</strong>
              <span>{slot.time}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</article>
