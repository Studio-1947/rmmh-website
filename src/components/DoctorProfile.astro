---
import Icon from "./Icon.astro";
import { weekDays, type Doctor } from "../data/doctors";
import { hours, parseSlots, weekSummary } from "../data/schedule";
import { site } from "../data/site";
import { getLang, l, useT } from "../i18n";

interface Props {
  doctor: Doctor;
}

const { doctor } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const name = l(doctor.name, lang);
const byDay = new Map(doctor.availability.map((a) => [a.day, parseSlots(a.time)]));
// Static build: start on the first working day; the script below switches to today (IST).
const firstDay = weekDays.find((d) => byDay.has(d)) ?? weekDays[0];
const location = l(doctor.location, lang).replace(/\s*\((.+)\)\s*$/, " · $1");
const summary = weekSummary(
  doctor.availability,
  (d) => t(`day.${d}`),
  t("doctor.off"),
  t("doctor.otherDaysOff"),
);
// Strings the client script needs to build the live status pill and day headings.
const strings = {
  today: t("doctor.today"),
  now: t("doctor.availableNow"),
  backToday: t("doctor.backToday"),
  nextOn: t("doctor.nextOn"),
  days: Object.fromEntries(weekDays.map((d) => [d, t(`day.${d}`)])),
};
---

<article
  class="profile"
  id={doctor.slug}
  data-reveal
  data-live={doctor.timingsConfirmed && doctor.availability.length > 0 ? "" : undefined}
  data-strings={JSON.stringify(strings)}
>
  <div class="profile-head">
    <div class="profile-photo">
      <img
        src={doctor.photo}
        alt={`${t("doctor.portrait")} ${name}`}
        loading="lazy"
        decoding="async"
        width="600"
        height="600"
      />
    </div>
    <div class="profile-id">
      <div class="profile-name">
        <h2>{name}</h2>
        <span class="status-pill" data-status hidden></span>
      </div>
      <p class="doctor-spec">{l(doctor.specialty, lang)}</p>
      <ul class="profile-meta">
        <li><Icon name="i-pin" />{location}</li>
        {
          doctor.languages && (
            <li>
              <Icon name="i-globe" />
              {doctor.languages.join(" · ")}
            </li>
          )
        }
      </ul>
    </div>
    <a class="btn btn-primary profile-book" href={site.phoneHref}
      ><Icon name="i-phone" />{t("doctor.book")}</a
    >
  </div>

  <div class="profile-body">
    <div class="profile-main">
      <h3 class="profile-label">{t("doctor.about")}</h3>
      <p class="profile-bio">{l(doctor.bio, lang)}</p>

      {
        doctor.skills.length > 0 && (
          <>
            <h3 class="profile-label">{t("doctor.skills")}</h3>
            <ul class="skill-list">
              {doctor.skills.map((skill) => (
                <li>
                  <span class="skill-check" aria-hidden="true">
                    <Icon name="i-check" />
                  </span>
                  {l(skill, lang)}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <section class="avail-card" aria-label={t("doctor.availability")}>
      <h3 class="profile-label">
        {t("doctor.availability")}
        {!doctor.timingsConfirmed && <em class="tbc">{t("doctor.tbcLong")}</em>}
      </h3>
      <div class="week" role="group" aria-label={t("doctor.week")}>
        {
          weekDays.map((day) => (
            <button
              type="button"
              class:list={["week-day", { on: byDay.has(day), "is-selected": day === firstDay }]}
              data-day={day}
              aria-pressed={day === firstDay ? "true" : "false"}
              aria-label={t(`dayFull.${day}`)}
            >
              <span class="week-name">{t(`day.${day}`)}</span>
              <span class="week-dot" aria-hidden="true" />
            </button>
          ))
        }
      </div>

      {
        weekDays.map((day) => {
          const slots = byDay.get(day);
          return (
            <div class="day-panel" data-day={day} hidden={day !== firstDay}>
              <p class="day-title">
                {t(`dayFull.${day}`)}
                <span class="day-today" hidden>
                  {" · "}
                  {t("doctor.today")}
                </span>
              </p>
              {slots ? (
                <ol class="slot-list" aria-label={t("doctor.slots")}>
                  {slots.map((slot) => (
                    <li class="slot" data-start={slot.start} data-end={slot.end}>
                      <div>
                        {slot.part && <span class="slot-part">{t(`doctor.${slot.part}`)}</span>}
                        <strong class="slot-time">{slot.label}</strong>
                      </div>
                      {hours(slot) && (
                        <span class="slot-hrs">
                          {hours(slot)} {t("doctor.hrs")}
                        </span>
                      )}
                    </li>
                  ))}
                </ol>
              ) : (
                <p class="slot-off">
                  {t("doctor.notInOn").replace("{day}", t(`dayFull.${day}`))} ·{" "}
                  {t("doctor.askCounter")}
                </p>
              )}
            </div>
          );
        })
      }

      {summary && <p class="avail-summary">{summary}</p>}
    </section>
  </div>
</article>

<script>
  // Select today's day (clinic time, IST), make the day chips switch panels,
  // and show a live "Available now" / "Next" pill from the slot times.
  const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

  function clinicNow() {
    const parts = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Kolkata",
      weekday: "short",
      hour: "numeric",
      minute: "numeric",
      hourCycle: "h23",
    }).formatToParts(new Date());
    const get = (type: string) => parts.find((p) => p.type === type)?.value ?? "";
    return { day: get("weekday"), mins: Number(get("hour")) * 60 + Number(get("minute")) };
  }

  function clock(mins: number) {
    const h = Math.floor(mins / 60);
    const m = String(mins % 60).padStart(2, "0");
    return `${h % 12 || 12}:${m} ${h < 12 ? "AM" : "PM"}`;
  }

  const now = clinicNow();

  document.querySelectorAll<HTMLElement>(".profile").forEach((profile) => {
    const chips = profile.querySelectorAll<HTMLButtonElement>(".week-day");
    const panels = profile.querySelectorAll<HTMLElement>(".day-panel");

    const select = (day: string) => {
      chips.forEach((c) => {
        const on = c.dataset.day === day;
        c.classList.toggle("is-selected", on);
        c.setAttribute("aria-pressed", String(on));
      });
      panels.forEach((p) => (p.hidden = p.dataset.day !== day));
    };
    chips.forEach((c) => c.addEventListener("click", () => select(c.dataset.day ?? "")));

    if (DAYS.includes(now.day)) {
      select(now.day);
      profile
        .querySelector<HTMLElement>(`.day-panel[data-day="${now.day}"] .day-today`)
        ?.removeAttribute("hidden");
      profile.querySelector(`.week-day[data-day="${now.day}"]`)?.classList.add("is-today");
    }

    const pill = profile.querySelector<HTMLElement>("[data-status]");
    if (!pill || !("live" in profile.dataset)) return;
    const s = JSON.parse(profile.dataset.strings ?? "{}");
    const slotsOn = (day: string) =>
      Array.from(profile.querySelectorAll<HTMLElement>(`.day-panel[data-day="${day}"] .slot`))
        .map((el) => ({ start: Number(el.dataset.start), end: Number(el.dataset.end) }))
        .filter((x) => x.end > x.start);

    const today = slotsOn(now.day);
    const current = today.find((x) => now.mins >= x.start && now.mins < x.end);
    const later = today.find((x) => x.start > now.mins);
    let text = "";
    if (current) {
      text = s.now.replace("{time}", clock(current.end));
      pill.classList.add("is-live");
    } else if (later) {
      text = s.backToday.replace("{time}", clock(later.start));
    } else {
      const start = DAYS.indexOf(now.day);
      for (let i = 1; i <= 7 && !text; i++) {
        const day = DAYS[(start + i) % 7];
        const first = slotsOn(day)[0];
        if (first)
          text = s.nextOn.replace("{day}", s.days[day]).replace("{time}", clock(first.start));
      }
    }
    if (text) {
      pill.textContent = text;
      pill.hidden = false;
    }
  });
</script>
