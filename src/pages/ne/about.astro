---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { founder, cofounder, cofounder1, custodian, team, timeline } from "../../data/legacy";
import { galleryTiles } from "../../data/gallery";
import { site } from "../../data/site";
import { getLang, l, useT } from "../../i18n";

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
---

<BaseLayout
  title={`${t("about.page")} | ${site.name} | Mirik, Darjeeling`}
  description={t("about.meta")}
>
  <section class="page-hero has-image">
    <div class="page-hero-bg" aria-hidden="true">
      <img src="/images/about-hero.jpg" alt="" fetchpriority="high" decoding="async" />
    </div>
    <div class="wrap">
      <p class="eyebrow">{t("about.page")}</p>
      <h1>{t("about.h1")}</h1>
      <p class="hero-sub" style="margin-inline:0; animation:none; opacity:1">
        {t("about.pageSub2")}
      </p>
    </div>
  </section>

  <section class="story">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t("about.founders")}</p>
      </div>
      <div class="founders">
        <div class="founder-col">
          <div class="legacy-portrait" data-reveal="scale">
            <img
              src={founder.photo}
              alt={l(founder.name, lang)}
              loading="lazy"
              decoding="async"
              width="720"
              height="900"
            />
            {
              founder.photoIsPlaceholder && (
                <span class="tbc photo-tag">{t("about.samplePhoto")}</span>
              )
            }
            <div class="legacy-caption">
              <strong>{l(founder.name, lang)}</strong>
              <span>{l(founder.role, lang)}</span>
            </div>
          </div>
          <div class="legacy-portrait" data-reveal="scale" style="--reveal-delay:120ms">
            <img
              src={cofounder1.photo}
              alt={l(cofounder1.name, lang)}
              loading="lazy"
              decoding="async"
              width="720"
              height="900"
            />
            {
              cofounder1.photoIsPlaceholder && (
                <span class="tbc photo-tag">{t("about.samplePhoto")}</span>
              )
            }
            <div class="legacy-caption">
              <strong>{l(cofounder1.name, lang)}</strong>
              <span>{l(cofounder1.role, lang)}</span>
            </div>
          </div>
        </div>
        <div class="legacy-portrait" data-reveal="scale" style="--reveal-delay:180ms">
          <img
            src={cofounder.photo}
            alt={l(cofounder.name, lang)}
            loading="lazy"
            decoding="async"
            width="720"
            height="900"
          />
          {
            cofounder.photoIsPlaceholder && (
              <span class="tbc photo-tag">{t("about.samplePhoto")}</span>
            )
          }
          <div class="legacy-caption">
            <strong>{l(cofounder.name, lang)}</strong>
            <span>{l(cofounder.role, lang)}</span>
          </div>
        </div>
        <div class="story-copy" data-reveal="right">
          {founder.intro.map((p) => <p>{l(p, lang)}</p>)}
          {cofounder.intro.map((p) => <p>{l(p, lang)}</p>)}
          {cofounder1.intro.map((p) => <p>{l(p, lang)}</p>)}
          <blockquote class="legacy-quote">“{l(founder.quote, lang)}”</blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="today">
    <div class="wrap split">
      <div class="legacy-portrait" data-reveal="scale">
        <img
          src={custodian.photo}
          alt={l(custodian.name, lang)}
          loading="lazy"
          decoding="async"
          width="720"
          height="900"
        />
        {
          custodian.photoIsPlaceholder && (
            <span class="tbc photo-tag">{t("about.samplePhoto")}</span>
          )
        }
        <div class="legacy-caption">
          <strong>{l(custodian.name, lang)}</strong>
          <span>{l(custodian.role, lang)}</span>
        </div>
      </div>
      <div class="split-copy story-copy" data-reveal="right">
        <p class="eyebrow">{t("about.today")}</p>
        <h2>{l(custodian.name, lang)}</h2>
        {custodian.intro.map((p) => <p>{l(p, lang)}</p>)}
      </div>
    </div>
  </section>

  <section class="team">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{t("about.team")}</p>
        <h2>{t("about.teamSub")}</h2>
      </div>
      <div class="team-grid">
        {
          team.map((m, i) => (
            <article class="team-card" data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
              <div class="team-photo">
                <img
                  src={m.photo}
                  alt={m.name}
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="720"
                />
                {m.photoIsPlaceholder && (
                  <span class="tbc photo-tag">{t("doctor.samplePhoto")}</span>
                )}
              </div>
              <strong>{m.name}</strong>
              <span class="doctor-spec">{l(m.role, lang)}</span>
              <p>{l(m.note, lang)}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="history">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{t("about.timeline")}</p>
        <h2>{t("about.timelineSub")}</h2>
      </div>
      <ol class="history-line">
        {
          timeline.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 90}ms`}>
              <span class="history-year">{item.year}</span>
              <h3>{l(item.title, lang)}</h3>
              <p>{l(item.text, lang)}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="gallery">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">{t("about.galleryEyebrow")}</p>
        <h2>{t("gallery.title")}</h2>
        <p>{t("gallery.sub")}</p>
      </div>
      <div class="gallery-grid">
        {
          galleryTiles.map((tile, i) => (
            <article class="img-card" data-reveal style={`--reveal-delay:${(i % 3) * 110}ms`}>
              <img src={tile.src} alt={tile.alt} loading="lazy" decoding="async" />
              <div class="img-card-body">
                <div class="img-card-icon">
                  <Icon name={tile.icon} />
                </div>
                <h3>{l(tile.title, lang)}</h3>
                <p>{l(tile.caption, lang)}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
